# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env* is already gitignored — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Bypasses Row Level Security. Never prefix with
# NEXT_PUBLIC_ and never import lib/supabase/admin.ts from client code.
SUPABASE_SERVICE_ROLE_KEY=
